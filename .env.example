# Example environment variables for next-learning (do NOT commit real secrets)

# Auth.js / NextAuth
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Existing Express API used by login/register
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE=http://localhost:4000

# Same MongoDB used by perfume-backend (registered users live here)
MONGO_URI=mongodb://127.0.0.1:27017/perfume-backend

# Resend (server-side only — never prefix with NEXT_PUBLIC_)
RESEND_API_KEY=
RESEND_FROM_EMAIL=A ROMANOVA <onboarding@resend.dev>

NEXT_PUBLIC_SITE_URL=http://localhost:3000
